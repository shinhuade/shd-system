        },
        "supplierCode": {
          "type": "string",
          "title": "廠商編號"
        },
        "contactPerson": {
          "type": "string",
          "title": "聯絡人"
        },
        "phone": {
          "type": "string",
          "title": "電話"
        },
        "fax": {
          "type": "string",
          "title": "傳真"
        },
        "email": {
          "type": "string",
          "title": "電子信箱"
        },
        "shippingAddress": {
          "type": "string",
          "title": "送貨地址"
        },
        "invoiceAddress": {
          "type": "string",
